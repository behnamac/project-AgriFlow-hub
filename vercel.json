{
  "buildCommand": "rm -rf node_modules package-lock.json && npm install --omit=optional && npm run build:vercel",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install --omit=optional --no-optional",
  "devCommand": "npm run dev",
  "env": {
    "NODE_ENV": "production",
    "DISABLE_ROLLUP_NATIVE": "true"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
